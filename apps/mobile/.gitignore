# Continuous Native Generation — native dirs are regenerated via `expo prebuild`,
# never committed. See AGENTS.md (Continuous Native Generation).
/ios
/android

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Dependencies
node_modules/

# Env (local only — commit .env.example, never .env)
.env
.env.*
!.env.example

# Native build cruft / logs
*.log
*.tsbuildinfo

# Upstream Material Symbols variable font + codepoints, downloaded on demand by
# scripts/build-symbol-fonts.py. Only the generated subsets in assets/fonts are
# committed.
.cache/

# Signing material — NEVER commit. EAS holds the upload key (credentialsSource
# defaults to remote); a keystore in the repo is a leaked secret even when
# password-protected. See AGENTS.md (Android OAuth client + signing).
*.jks
*.keystore
*.p12
*.p8
*.pem
# Google Play service account for `eas submit` (eas.json submit.production.android).
play-service-account.json

# node-gyp configure output, committed by accident once.
build/
