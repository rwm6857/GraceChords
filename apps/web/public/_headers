/*
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Vite content-hashes everything under /assets/, so a given URL never changes
# and browsers may keep it for a year. HTML, sw.js and un-hashed files keep
# Cloudflare's default (revalidate every time), which is what lets a deploy
# take effect immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Mobile deep-link association files must be served as JSON (Apple/Android require it).
/.well-known/apple-app-site-association
  Content-Type: application/json
/.well-known/assetlinks.json
  Content-Type: application/json
